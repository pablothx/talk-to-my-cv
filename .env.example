# Copy to .env and adjust. Every value below is the default: the project runs
# 100% locally with no keys, accounts or cost.

# Where Ollama listens (native by default; the compose `ollama` profile uses the same port).
OLLAMA_HOST=http://localhost:11434

# LLM that writes the answers: `ollama` (local, free) or `groq` (hosted, needs a key).
# Each provider has its own model setting, so switching is a one-line change.
# With `groq`, the retrieved CV chunks are sent to Groq's API: they leave your machine.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings are always computed locally with Ollama.
EMBED_MODEL=bge-m3

# Host port for the pgvector container (change it if 5432 is taken; keep DATABASE_URL in sync).
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talk_to_my_cv

# Where the chunks live: `pgvector` (vector search only) or `opensearch`
# (vector, keyword = BM25, or hybrid = both). OpenSearch starts with `docker compose up -d`.
VECTOR_STORE=pgvector
SEARCH_MODE=vector
# pipeline (steps 3-6) | graph (step 7: LangGraph with LLM verification, ~3x slower)
ENGINE=pipeline
OPENSEARCH_PORT=9200
OPENSEARCH_URL=http://localhost:9200

# Knowledge base: `kb.example` (fictional persona) or `kb` (your own CV).
KB_DIR=kb.example
